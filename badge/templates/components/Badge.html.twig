{%- props
    ## 'default'|'secondary'|'destructive'|'outline'|'ghost'|'link' The visual style variant.
    variant = 'default',
    ## 'span'|'a' The HTML tag to render; use `a` when the badge navigates.
    as = 'span',
    ## string|null A CSS colour replacing the colour of the variant, in a data attribute the stylesheet reads where the browser types attr(); anything else than a colour is left out.
    color = null
-%}
{%- set _tag = as is same as('a') ? 'a' : 'span' -%}
{%- set _variant = {secondary: 'isSecondary', destructive: 'isDanger', outline: 'isOutline', ghost: 'isGhost', link: 'isLink'}[variant] ?? '' -%}
{%- set _color = color is not null and color matches '/^[#%(),.\\w\\s-]+$/' ? color : null -%}
<{{ _tag }} data-slot="badge" data-variant="{{ variant }}"{% if _color is not null %} data-color="{{ _color }}"{% endif %}{{ attributes.defaults({class: ('isBadge ' ~ _variant)|trim}) }}>
{##- The badge label or content. -#}
{%- block content %}{% endblock -%}
</{{ _tag }}>
