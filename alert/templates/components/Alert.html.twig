{%- props
    ## 'default'|'destructive' The visual style variant.
    variant = 'default'
-%}
<div data-slot="alert" data-variant="{{ variant }}"{{ attributes.defaults({class: 'isAlert' ~ (variant is same as('destructive') ? ' isDanger' : ''), role: 'alert'}) }}>
{##- The alert content, typically includes `Alert:Title` and `Alert:Description`. -#}
{%- block content %}{% endblock -%}
</div>
