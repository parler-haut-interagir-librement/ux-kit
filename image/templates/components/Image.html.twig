{#-
 # An image: one img, in a figure when it has a caption, under the prop names of Symfony UX Image, without a service, a
 # script or an inline style; its layout, ratio, fit and crop written as classes. A javascript:, vbscript: or data: URL
 # other than data:image/ is refused: a refused src renders nothing, a refused srcset is left out whole.
 #}
{%- props
    ## string The URL of the image.
    src,
    ## string The text alternative; an empty string for a decorative image, which screen readers then skip.
    alt,
    ## int The width of the image, so that its space is reserved at its ratio before it loads.
    width,
    ## int The height of the image, so that its space is reserved at its ratio before it loads.
    height,
    ## string|array<int|string,string>|null The candidates as HTML writes them, or a map of densities, or of widths with sizes or a fluid layout, to URLs.
    srcset = null,
    ## string|null The sizes of a srcset of widths, preceded by "auto, " while the image loads lazily; computed from the layout when null.
    sizes = null,
    ## string|null How the image fills its container: "fixed", at its width; "constrained", never wider than its width; "full-width"; none by default.
    layout = null,
    ## string|null The ratio of its box, "16/9", "4/3", "3/2", "1/1", "21/9", "3/4", "2/3", "9/16", or "custom", read from a custom property a class sets.
    aspect = null,
    ## string|null How the image fills its box, "cover" or "contain": "cover" by default when it has a ratio.
    fit = null,
    ## string|null Where the image is cropped in its box: "center", "top", "bottom", "left" or "right".
    position = null,
    ## bool Whether it is the main image above the fold: loaded eagerly and fetched first, its decoding left to the browser.
    priority = false,
    ## string|null How it loads, "lazy" or "eager": "lazy" by default, "eager" with priority.
    loading = null,
    ## string|null How it is decoded, "async", "sync" or "auto": "async" by default, none written with priority.
    decoding = null,
    ## string|null A caption under the image, which a figure then holds with it; shown even when the image is decorative.
    caption = null
-%}
{%- set _refused = '#(^|,)[[:cntrl:] ]*(javascript:|vbscript:|data:(?!image/))#i' -%}
{%- set _controls = {"\t": '', "\n": '', "\r": ''} -%}
{%- if src is not empty and not (src|replace(_controls) matches _refused) -%}
    {%- set _loading = loading in ['lazy', 'eager'] ? loading : (priority ? 'eager' : 'lazy') -%}
    {%- set _sizes = sizes is not empty ? sizes : {
        constrained: width is empty ? null : '(min-width: ' ~ width ~ 'px) ' ~ width ~ 'px, 100vw',
        'full-width': '100vw',
    }[layout] ?? null -%}
    {%- set _srcset = srcset is iterable ? srcset|map((url, key) => url ~ ' ' ~ key ~ (_sizes is empty ? 'x' : 'w'))|join(', ') : srcset -%}
    {%- set _srcset = _srcset is empty or _srcset|replace(_controls) matches _refused ? null : _srcset -%}
    {%- set _sizes = _srcset is null or _sizes is empty ? null : (_loading is same as('lazy') and not (_sizes|lower starts with 'auto') ? 'auto, ' ~ _sizes : _sizes) -%}
    {%- set _ratio = {'16/9': 'hasRatio16x9', '4/3': 'hasRatio4x3', '3/2': 'hasRatio3x2', '1/1': 'hasRatio1x1', '21/9': 'hasRatio21x9', '3/4': 'hasRatio3x4', '2/3': 'hasRatio2x3', '9/16': 'hasRatio9x16', custom: 'hasRatio'}[aspect|default('')|replace({' ': ''})] ?? null -%}
    {%- set _class = [
        'isImage',
        {fixed: 'hasLayoutFixed', 'full-width': 'hasLayoutFullWidth'}[layout] ?? null,
        _ratio,
        {cover: 'hasFitCover', contain: 'hasFitContain'}[fit ?? (_ratio is null ? '' : 'cover')] ?? null,
        {center: 'hasPositionCenter', top: 'hasPositionTop', bottom: 'hasPositionBottom', left: 'hasPositionLeft', right: 'hasPositionRight'}[position] ?? null,
        attributes.all.class ?? null,
    ]|filter(name => name is not empty)|join(' ') -%}
    {%- set _allowed = alt is same as('')
        ? '#^(id|crossorigin|referrerpolicy|itemprop|draggable|data-[a-z0-9-]+)$#'
        : '#^(id|title|crossorigin|referrerpolicy|itemprop|draggable|(data|aria)-[a-z0-9-]+)$#' -%}
    {%- if caption is not empty -%}<figure>{%- endif -%}
    <img {{ html_attr({
        class: _class,
        src: src,
        srcset: _srcset,
        sizes: _sizes,
        alt: alt,
        width: width,
        height: height,
        loading: _loading,
        decoding: decoding in ['async', 'sync', 'auto'] ? decoding : (priority ? null : 'async'),
        fetchpriority: priority ? 'high' : null,
    }, attributes.all|filter((value, name) => name matches _allowed)) }}>
    {%- if caption is not empty -%}<figcaption>{{ caption }}</figcaption></figure>{%- endif -%}
{%- endif -%}
