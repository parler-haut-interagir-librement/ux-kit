{%- props
    ## string Unique identifier used to generate internal Sheet IDs.
    id,
    ## 'top'|'right'|'bottom'|'left' Which edge the sheet slides in from.
    side = 'right',
    ## bool Whether the sheet is open on initial render.
    open = false
-%}
{%- set _sheet_id = 'sheet-' ~ id -%}
{%- do provide('sheet.id', _sheet_id) -%}
{%- do provide('sheet.side', side) -%}
{%- do provide('sheet.titleId', _sheet_id ~ '-title') -%}
{%- do provide('sheet.descriptionId', _sheet_id ~ '-description') -%}
<div data-slot="sheet" data-dialog-open-value="{{ open ? 'true' : 'false' }}"{{ attributes.defaults({class: 'hasDialog', 'data-controller': 'dialog'}) }}>
{##- The sheet structure, typically includes `Sheet:Trigger` and `Sheet:Content`. -#}
{%- block content %}{% endblock -%}
</div>
