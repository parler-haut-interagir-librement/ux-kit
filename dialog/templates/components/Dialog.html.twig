{%- props
    ## string Unique identifier used to generate internal Dialog IDs.
    id,
    ## bool Whether the dialog is open on initial render.
    open = false
-%}
{%- set _dialog_id = 'dialog-' ~ id -%}
{%- do provide('dialog.id', _dialog_id) -%}
{%- do provide('dialog.titleId', _dialog_id ~ '-title') -%}
{%- do provide('dialog.descriptionId', _dialog_id ~ '-description') -%}
<div data-slot="dialog" data-dialog-open-value="{{ open ? 'true' : 'false' }}"{{ attributes.defaults({class: 'hasDialog', 'data-controller': 'dialog'}) }}>
{##- The dialog structure, typically includes `Dialog:Trigger` and `Dialog:Content`. -#}
{%- block content %}{% endblock -%}
</div>
