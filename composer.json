{
    "name": "phil/ux-kit",
    "description": "PHIL UX kit for the Symfony UX Toolkit: the same recipes as the Shadcn kit, styled with phil-ux, installed with ux:install --kit; with the Twig functions its image recipes call, image_origin() and image_sources()",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux",
        "ux-toolkit",
        "twig-component",
        "stimulus",
        "design-system",
        "accessibility"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/url": "^0.1.3@dev",
        "psr/log": "^3.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phil/qr-code-bundle": "^0.1@dev",
        "php-webdriver/webdriver": "^1.16",
        "phpunit/phpunit": "^13.4",
        "psr/container": "^2.0",
        "psr/link": "^2.0",
        "symfony/asset": "^8.2",
        "symfony/asset-mapper": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/panther": "^2.4",
        "symfony/twig-bundle": "^8.2",
        "symfony/ux-twig-component": "^3.7",
        "symfony/web-link": "^8.2",
        "twig/extra-bundle": "^3.24",
        "twig/html-extra": "^3.24"
    },
    "suggest": {
        "php-webdriver/webdriver": "To extend the browser test case of src/Test/",
        "phpunit/phpunit": "To extend the browser test case of src/Test/",
        "symfony/asset-mapper": "For image_sources(), the props of a picture from the files of an image among the assets",
        "symfony/panther": "To extend the browser test case of src/Test/",
        "symfony/web-link": "For the preload of the main image of a page, which the image recipe requires"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\UxKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\UxKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    }
}
