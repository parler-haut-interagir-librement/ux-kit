{%- props
    ## string The value submitted when this radio is selected.
    value,
    ## bool Whether this radio is initially checked.
    checked = false,
    ## bool Whether the item is disabled.
    disabled = false,
    ## bool Whether selecting the item closes the menu.
    closeOnSelect = false
-%}
<button type="button" role="menuitemradio" data-slot="dropdown-menu-radio-item" data-dropdown-menu-target="item" data-value="{{ value }}" data-close-on-select="{{ closeOnSelect ? 'true' : 'false' }}" data-disabled="{{ disabled ? 'true' : 'false' }}" aria-checked="{{ checked ? 'true' : 'false' }}" aria-disabled="{{ disabled ? 'true' : 'false' }}"{% if disabled %} disabled{% endif %}{{ attributes.defaults({class: 'isDropdownItem', 'data-action': 'click->dropdown-menu#selectRadio'}) }}>
<span class="isDropdownIndicator" aria-hidden="true" data-radio-indicator{% if not checked %} hidden{% endif %}>&#10003;</span>
{##- The label text. -#}
{%- block content %}{% endblock -%}
</button>
