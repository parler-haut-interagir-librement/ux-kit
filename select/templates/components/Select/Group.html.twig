{%- props
    ## string|null Unique identifier linking the group to its `Select:Label`, so the group is announced with a name.
    id = null
-%}
{%- do provide('selectGroup.labelId', id is null ? null : 'select-group-' ~ id ~ '-label') -%}
<div role="group"{% if id is not null %} aria-labelledby="select-group-{{ id }}-label"{% endif %} data-slot="select-group"{{ attributes.defaults({class: 'isSelectGroup'}) }}>
{##- The group options, typically a `Select:Label` followed by `Select:Item` components. -#}
{%- block content %}{% endblock -%}
</div>
